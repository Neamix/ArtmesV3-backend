model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  password      String    @default("")
  avatar        String?
  nationality   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}
