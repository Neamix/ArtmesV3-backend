model User {
  id             Int         @id @default(autoincrement())
  name           String
  email          String      @unique
  password       String
  avatar         String?
  nationality    String?
  ownedWorkspace Workspace[] @relation("WorkspaceOwner")
  workspaces     Workspace[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}