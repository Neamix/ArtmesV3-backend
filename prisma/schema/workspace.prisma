model Workspace {
    id       Int    @id @default(autoincrement())
    slug     String
    name     String
    owner_id Int
    owner User @relation("WorkspaceOwner",fields: [owner_id],references: [id],onDelete: Cascade)
    members User[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([owner_id])
    @@unique([slug])
}

model WorkspaceUsers {
    id Int @id @default(autoincrement())
    user_id Int
    workspace_id Int
    role Roles
}

enum Roles {
    Member
    Admin
    Owner
}